{
  "name": "autocrm",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "web": "npm run dev -w @autocrm/web",
    "mobile": "npm run start -w @autocrm/mobile",
    "android": "npm run android -w @autocrm/mobile",
    "ios": "npm run ios -w @autocrm/mobile",
    "build": "npm run build -w @autocrm/web",
    "build:mobile": "npm run export -w @autocrm/mobile",
    "lint": "eslint apps packages tests",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:supabase": "playwright test --config playwright.supabase.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "typescript": "~5.9.2",
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.55.1"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
